# Environment Configuration Placeholder (DO NOT COMMIT REAL SECRETS)
ENVIRONMENT=development
DEBUG=True

# Database Configuration
# asyncpg for FastAPI runtime, psycopg2 for synchronous migrations
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edtech_dev
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/edtech_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edtech_test
TEST_SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/edtech_test

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_256_bit_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Media Storage (Object Storage - Cloudflare R2 / S3)
STORAGE_PROVIDER=mock
S3_BUCKET_NAME=edtech-media-dev
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
